{
  "description": "WillTech visual COMPLEMENTAR para Codex (independente do núcleo de automação). Mescla estes hooks ao .codex/hooks.json do projeto. Exige trust do usuário via /hooks. Não altera o aplicativo Codex; apenas observa eventos oficiais e alimenta o visualizador local. Nenhum hook chama modelo ou faz rede.",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ],
    "Interrupt": [
      { "hooks": [ { "type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/codex/willtech-visual/hooks/willtech_bridge.py\"", "async": true, "timeout": 5 } ] }
    ]
  }
}